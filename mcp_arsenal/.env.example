# .env.example
# Este archivo es una plantilla. Copie este archivo a .env y rellene los valores.
# ¡NO AÑADA el archivo .env a git!

# Se requiere un Token de Acceso Personal (PAT) de GitHub para que el servidor MCP
# pueda autenticarse y acceder a la API de GitHub.
# Genere uno en: https://github.com/settings/tokens
GITHUB_PAT="ghp_TuTokenDeGitHubAqui"
